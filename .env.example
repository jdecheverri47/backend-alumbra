NODE_ENV=development
# Front (Next.js) usa el 3000; el backend corre en 4000.
PORT=4000
DATABASE_URL=postgresql://alumbra:password@localhost:5432/alumbra?schema=public

# Auth
# Genera uno con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Vacío en dev (localhost); en prod .iglesiaalumbra.org
COOKIE_DOMAIN=
# Origen del frontend para CORS con credenciales
CORS_ORIGIN=http://localhost:3000

# OAuth Client ID (web) para "Continuar con Google". Vacío = /auth/google responde 503.
GOOGLE_CLIENT_ID=

# Token de los recordatorios (POST /internal/notifications/tick con el
# encabezado X-Cron-Token). Vacío = el endpoint responde 503.
# Genera uno con: openssl rand -hex 32
CRON_TOKEN=

# Correo de los avisos con Resend. Vacío = los correos se escriben en el log.
RESEND_API_KEY=
# EMAIL_FROM="Alumbra <notificaciones@iglesiaalumbra.org>"
# EMAIL_REPLY_TO=info@iglesiaalumbra.org
# Frontend, para los enlaces de los correos (por defecto, el primer CORS_ORIGIN).
# APP_URL=http://localhost:3000
