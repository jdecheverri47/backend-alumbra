NODE_ENV=development
# Front (Next.js) usa el 3000; el backend corre en 4000.
PORT=4000
DATABASE_URL=postgresql://alumbra:password@localhost:5432/alumbra?schema=public

# Auth
# Genera uno con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Vacío en dev (localhost); en prod .iglesiaalumbra.org
COOKIE_DOMAIN=
# Origen del frontend para CORS con credenciales
CORS_ORIGIN=http://localhost:3000
