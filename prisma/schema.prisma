generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseRole {
  ASISTENTE
  MIEMBRO
}

enum MinistryRole {
  LEADER
  MEMBER
}

enum GroupType {
  MADUREZ
  CONEXION
  CURSO
}

enum JourneyStage {
  PRE_ENTREVISTA
  APLAZADO
  VALIDADO
  EN_RUTA
  ENTREGA_FINAL
  FILTRO_IGLESIA
  ENTREVISTA_PASTORAL
  MIEMBRO
  NO_CONTINUA
}

enum PostType {
  POST
  ANUNCIO
}

enum ReactionType {
  LIKE
  AMEN
  LOVE
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupSessionStatus {
  PROGRAMADA
  REPROGRAMADA
  COMPLETADA
  CANCELADA
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  baseRole  BaseRole @default(ASISTENTE)
  isPastor  Boolean  @default(false)
  // Rol de líder (p. ej. dirige cohortes de la Ruta). Lo otorgan/revocan los pastores.
  isLeader  Boolean  @default(false)

  // Auth: credentials login. Nullable — bulk-imported users have no password yet.
  passwordHash String?
  canSignIn    Boolean @default(false)

  phone     String?
  photoUrl  String?
  coverUrl  String?
  googleId  String?   @unique
  birthDate DateTime?

  // Registros de membresía (los administra un pastor).
  membershipDate DateTime?
  baptismDate    DateTime?

  ministryMemberships    MinistryMembership[]
  sessions               Session[]
  ledGroups              Group[]                @relation("GroupLeader")
  groupMemberships       GroupMembership[]      @relation("GroupMember")
  addedGroupMembers      GroupMembership[]      @relation("GroupMemberAddedBy")
  createdEvents          Event[]
  posts                  Post[]
  postReactions          PostReaction[]
  postComments           PostComment[]
  createdSessions        GroupSession[]         @relation("GroupSessionCreator")
  uploadedMaterials      SessionMaterial[]      @relation("MaterialUploader")
  submissions            AssignmentSubmission[] @relation("Submitter")
  attendances            SessionAttendance[]    @relation("Attendee")
  recordedAttendances    SessionAttendance[]    @relation("AttendanceRecorder")
  courseCompletions      CourseCompletion[]     @relation("CompletionUser")
  certifiedCompletions   CourseCompletion[]     @relation("CompletionCertifier")
  courseEnrollments      CourseEnrollment[]     @relation("EnrollmentUser")
  placedEnrollments      CourseEnrollment[]     @relation("EnrollmentPlacer")
  membershipJourney      MembershipJourney?     @relation("JourneyUser")
  interviewedJourneys    MembershipJourney[]    @relation("JourneyInterviewer")
  assignedJourneys       MembershipJourney[]    @relation("JourneyAssignedLeader")
  churchObservations     ChurchObservation[]
  accessRequest          AccessRequest?         @relation("AccessRequestUser")
  reviewedAccessRequests AccessRequest[]        @relation("AccessRequestReviewer")

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  PostPollVote PostPollVote[]

  @@index([deletedAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Alguien entró con Google y la iglesia todavía no le ha dado acceso. Lo
// revisan pastores y líderes de Acogida: aprobar crea (o habilita) el User.
model AccessRequest {
  id        String              @id @default(cuid())
  email     String              @unique
  googleId  String              @unique
  firstName String
  lastName  String
  photoUrl  String?
  phone     String?
  note      String?
  status    AccessRequestStatus @default(PENDING)

  // Si el correo ya era de un User (p. ej. importado sin acceso), se enlaza aquí
  // desde el principio; si no, al aprobar.
  userId       String?   @unique
  user         User?     @relation("AccessRequestUser", fields: [userId], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("AccessRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Ministry {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  memberships MinistryMembership[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
}

model MinistryMembership {
  id         String       @id @default(cuid())
  userId     String
  ministryId String
  role       MinistryRole @default(MEMBER)
  joinedAt   DateTime     @default(now())
  leftAt     DateTime?

  user     User     @relation(fields: [userId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([userId, ministryId, joinedAt])
  @@index([ministryId])
  @@index([userId])
}

model Group {
  id          String    @id @default(cuid())
  type        GroupType
  name        String
  description String?
  leaderId    String
  // Cohorte de un curso (Evangelio / Ruta de Crecimiento) cuando type = CURSO.
  courseId    String?
  // Weekly in-person meeting; the client projects it onto the calendar.
  meetingDay  Int? // 0=domingo … 6=sábado
  meetingTime String? // "19:00"
  location    String?

  leader      User                @relation("GroupLeader", fields: [leaderId], references: [id])
  course      Course?             @relation(fields: [courseId], references: [id])
  memberships GroupMembership[]
  events      Event[]
  sessions    GroupSession[]
  journeys    MembershipJourney[] @relation("JourneyRutaGroup")
  placements  CourseEnrollment[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([leaderId])
}

model GroupMembership {
  id        String    @id @default(cuid())
  userId    String
  groupId   String
  addedById String?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  user    User  @relation("GroupMember", fields: [userId], references: [id])
  group   Group @relation(fields: [groupId], references: [id])
  addedBy User? @relation("GroupMemberAddedBy", fields: [addedById], references: [id])

  @@unique([userId, groupId, joinedAt])
  @@index([groupId])
  @@index([userId])
}

model GroupSession {
  id      String @id @default(cuid())
  groupId String

  // Fecha canónica de la reunión de esa semana; startsAt difiere si fue reprogramada.
  scheduledFor DateTime
  startsAt     DateTime
  status       GroupSessionStatus @default(PROGRAMADA)
  title        String?
  note         String?
  createdById  String
  // Clase del currículo que implementa esta sesión (cohortes de curso).
  lessonId     String?

  group       Group               @relation(fields: [groupId], references: [id])
  createdBy   User                @relation("GroupSessionCreator", fields: [createdById], references: [id])
  lesson      CourseLesson?       @relation(fields: [lessonId], references: [id])
  materials   SessionMaterial[]
  assignments SessionAssignment[]
  attendances SessionAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, scheduledFor])
  @@index([startsAt])
}

model SessionMaterial {
  id           String   @id @default(cuid())
  sessionId    String
  title        String
  url          String
  uploadedById String
  createdAt    DateTime @default(now())

  session    GroupSession @relation(fields: [sessionId], references: [id])
  uploadedBy User         @relation("MaterialUploader", fields: [uploadedById], references: [id])

  @@index([sessionId])
}

model SessionAssignment {
  id          String    @id @default(cuid())
  sessionId   String
  title       String
  description String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())

  session     GroupSession           @relation(fields: [sessionId], references: [id])
  submissions AssignmentSubmission[]

  @@index([sessionId])
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  url          String
  submittedAt  DateTime @default(now())

  assignment SessionAssignment @relation(fields: [assignmentId], references: [id])
  user       User              @relation("Submitter", fields: [userId], references: [id])

  @@unique([assignmentId, userId])
}

model SessionAttendance {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  checkedInAt  DateTime @default(now())
  recordedById String

  session    GroupSession @relation(fields: [sessionId], references: [id])
  user       User         @relation("Attendee", fields: [userId], references: [id])
  recordedBy User         @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([sessionId, userId])
}

model Course {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  description    String?
  prerequisiteId String?

  prerequisite Course?  @relation("CoursePrerequisite", fields: [prerequisiteId], references: [id])
  dependents   Course[] @relation("CoursePrerequisite")

  topics      CourseTopic[]
  groups      Group[]
  completions CourseCompletion[]
  enrollments CourseEnrollment[]

  createdAt DateTime @default(now())
}

model CourseTopic {
  id          String  @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String?

  course  Course         @relation(fields: [courseId], references: [id])
  lessons CourseLesson[]

  @@unique([courseId, order])
}

model CourseLesson {
  id          String  @id @default(cuid())
  topicId     String
  order       Int
  title       String
  description String?

  topic    CourseTopic        @relation(fields: [topicId], references: [id])
  tasks    CourseLessonTask[]
  sessions GroupSession[]

  @@unique([topicId, order])
}

model CourseLessonTask {
  id          String  @id @default(cuid())
  lessonId    String
  order       Int
  title       String
  description String?

  lesson CourseLesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, order])
}

// Inscripción abierta a un curso (Evangelio); luego un pastor/líder lo mueve a una cohorte.
model CourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  placedGroupId String?
  placedAt      DateTime?
  placedById    String?

  user        User   @relation("EnrollmentUser", fields: [userId], references: [id])
  course      Course @relation(fields: [courseId], references: [id])
  placedGroup Group? @relation(fields: [placedGroupId], references: [id])
  placedBy    User?  @relation("EnrollmentPlacer", fields: [placedById], references: [id])

  @@unique([userId, courseId])
  @@index([courseId, placedAt])
}

model CourseCompletion {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  completedAt   DateTime @default(now())
  certifiedById String

  user        User   @relation("CompletionUser", fields: [userId], references: [id])
  course      Course @relation(fields: [courseId], references: [id])
  certifiedBy User   @relation("CompletionCertifier", fields: [certifiedById], references: [id])

  @@unique([userId, courseId])
}

model MembershipJourney {
  id     String       @id @default(cuid())
  userId String       @unique
  stage  JourneyStage @default(PRE_ENTREVISTA)

  interviewerId     String?
  preInterviewAt    DateTime?
  preInterviewNotes String?

  validatedAt DateTime?

  // Líder de ruta al que se asignó el candidato (él decide la cohorte).
  assignedLeaderId String?

  rutaGroupId     String?
  rutaCompletedAt DateTime?

  essayUrl         String?
  testimony        String?
  imageUrl         String?
  finalSubmittedAt DateTime?

  churchFilterOpenedAt DateTime?
  churchFilterClosedAt DateTime?
  churchFilterPassed   Boolean?

  pastoralInterviewAt DateTime?
  covenantSignedAt    DateTime?

  // Notas internas pastorales.
  notes String?

  user           User   @relation("JourneyUser", fields: [userId], references: [id])
  interviewer    User?  @relation("JourneyInterviewer", fields: [interviewerId], references: [id])
  assignedLeader User?  @relation("JourneyAssignedLeader", fields: [assignedLeaderId], references: [id])
  rutaGroup      Group? @relation("JourneyRutaGroup", fields: [rutaGroupId], references: [id])

  observations ChurchObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
}

model ChurchObservation {
  id        String   @id @default(cuid())
  journeyId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey MembershipJourney @relation(fields: [journeyId], references: [id])
  author  User              @relation(fields: [authorId], references: [id])

  @@unique([journeyId, authorId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  // Afiche del evento: ruta /uploads/... o URL http(s).
  imageUrl    String?
  // null = fecha por definir; no sale en el calendario, sino en la lista aparte.
  startsAt    DateTime?
  endsAt      DateTime?
  // null = general event, visible to everyone
  groupId     String?
  createdById String
  // true = solo lo ven miembros (y pastores); no aparece para asistentes.
  membersOnly Boolean   @default(false)

  group     Group? @relation(fields: [groupId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])
  posts     Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([groupId])
}

model Post {
  id          String    @id @default(cuid())
  authorId    String
  type        PostType  @default(POST)
  body        String
  // Only ANUNCIO posts get pinned; ordered by pinnedAt desc.
  pinnedAt    DateTime?
  // Interno: solo miembros y pastores lo ven (la misma regla que los eventos).
  membersOnly Boolean   @default(false)
  eventId     String?

  author    User           @relation(fields: [authorId], references: [id])
  event     Event?         @relation(fields: [eventId], references: [id])
  images    PostImage[]
  reactions PostReaction[]
  comments  PostComment[]
  poll      PostPoll?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([deletedAt])
}

// Encuesta de un post: la pregunta es el cuerpo del post. Un voto por persona,
// que no se cambia (como en X/Twitter).
model PostPoll {
  id       String    @id @default(cuid())
  postId   String    @unique
  // null = no cierra.
  closesAt DateTime?

  post    Post             @relation(fields: [postId], references: [id])
  options PostPollOption[]
  votes   PostPollVote[]

  createdAt DateTime @default(now())
}

model PostPollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  position Int

  poll  PostPoll       @relation(fields: [pollId], references: [id])
  votes PostPollVote[]

  @@index([pollId])
}

model PostPollVote {
  id       String @id @default(cuid())
  pollId   String
  optionId String
  userId   String

  poll   PostPoll       @relation(fields: [pollId], references: [id])
  option PostPollOption @relation(fields: [optionId], references: [id])
  user   User           @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([optionId])
}

enum PostMediaKind {
  IMAGE
  VIDEO
}

// Imágenes y videos del post (la tabla conserva el nombre de cuando solo
// había imágenes).
model PostImage {
  id       String        @id @default(cuid())
  postId   String
  url      String
  kind     PostMediaKind @default(IMAGE)
  position Int           @default(0)

  post Post @relation(fields: [postId], references: [id])

  @@index([postId])
}

model PostReaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id       String @id @default(cuid())
  postId   String
  authorId String
  body     String

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([postId])
}
